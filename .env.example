# Supabase Project Settings -> API. Public values only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Your exact production origin. Change for local development or a separate preview deployment.
NEXT_PUBLIC_SITE_URL=https://YOUR_PROJECT.vercel.app
# Connect -> Transaction pooler URI. URL-encode special characters in password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres
# If required: project's CA certificate from Supabase Database settings, as PEM (literal \n supported).
DATABASE_CA_CERT=
# Supabase secret key (or legacy service_role key). SERVER ONLY.
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
SUPABASE_STORAGE_BUCKET=logoped-private
# Only this verified email can initialize the first administrator.
ADMIN_EMAIL=YOUR_EMAIL
# Optional AI drafts; leave blank until you choose a provider model and key.
OPENAI_API_KEY=
OPENAI_MODEL=
